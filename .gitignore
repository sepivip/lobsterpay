# Web public/ assets are intentional site artifacts (OG card, brand SVGs,
# icon.svg). Whitelist back in over the broad *.png / *.jpg rules above.
!apps/web/public/*.png
!apps/web/public/*.jpg

# Claude Code session transcripts (may contain pasted secrets)
claude-session.jsonl
*.session.jsonl

# Installed third-party CLI skills (not part of project source).
# The leading slash on /skills/ anchors to repo root so apps/api/src/skills
# (project source) is NOT ignored.
.claude/skills/
.agents/skills/
/skills/
.continue/
.windsurf/

# Third-party reference source copied locally during integration research
# (e.g. agon-gateway and coinbase/x402 repo snapshots). Don't vendor these
# into our tree — they're other repos' code and must not be checked in.
scripts/agon-refs/
