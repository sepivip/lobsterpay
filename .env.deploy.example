# .env.deploy — Solana on-chain deploy secrets (program keypair + deployer wallet)
#
# This file is READ BY HAND at deploy time to restore the program keypair and
# deployer wallet keypair from base58 env vars into JSON keypair files that
# `anchor build` and `anchor deploy` can consume.
#
# It is NOT loaded by the Fastify API, the Next.js web app, or Railway at
# runtime. It exists solely so that deploy-time keypairs can be transferred
# across machines (e.g. Windows dev box → macOS deploy box) via a password
# manager, without committing raw keypair JSON files to git.
#
# ⚠️  NEVER COMMIT A REAL .env.deploy.
#     This .example file is a template; the real .env.deploy is gitignored.
#     The base58 keypair strings below are secrets — losing them means losing
#     the ability to redeploy / upgrade the program under the same program id.
#     Back up the real values in a password manager as a secure note.
#
# ---------------------------------------------------------------------------
# PROGRAM_KEYPAIR
# ---------------------------------------------------------------------------
# Base58-encoded 64-byte Solana keypair. Determines the program's on-chain
# address (its program id). Generated once per program; preserve it to keep
# redeploying under the same id on other clusters or after cluster resets.
#
# To generate a fresh one:
#   solana-keygen new --outfile /tmp/program.json --no-bip39-passphrase --force --silent
#   # then base58-encode the 64-byte array inside /tmp/program.json
#
# To restore at deploy time on a new machine:
#   source .env.deploy
#   mkdir -p target/deploy
#   node -e '
#     const A = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
#     const dec = (s) => { let n=0n; for (const c of s) n = n*58n + BigInt(A.indexOf(c));
#       const out=[]; while(n>0n){out.unshift(Number(n%256n)); n/=256n;}
#       for (const c of s) { if (c !== "1") break; out.unshift(0); } return out; };
#     require("fs").writeFileSync(process.argv[1], JSON.stringify(dec(process.env.PROGRAM_KEYPAIR)));
#   ' target/deploy/lobsterpay-keypair.json
PROGRAM_KEYPAIR=REPLACE_ME_base58_encoded_64_byte_keypair

# ---------------------------------------------------------------------------
# PROGRAM_ID
# ---------------------------------------------------------------------------
# Public program id derived from PROGRAM_KEYPAIR. Not secret — it's the same
# value you see in Anchor.toml, programs/lobsterpay/src/lib.rs (declare_id!),
# apps/web/src/lib/solana.ts (PROGRAM_ID), apps/api/src/solana/instructions.ts
# (LOBSTERPAY_PROGRAM_ID), and the Railway LOBSTERPAY_PROGRAM_ID /
# NEXT_PUBLIC_LOBSTERPAY_PROGRAM_ID env vars.
#
# Kept here for convenience so `source .env.deploy` puts it in shell scope
# alongside the secrets.
PROGRAM_ID=REPLACE_ME_program_id_base58_pubkey

# ---------------------------------------------------------------------------
# DEPLOYER_KEYPAIR
# ---------------------------------------------------------------------------
# Base58-encoded 64-byte Solana keypair. Signs the `anchor deploy` tx, pays
# program rent (~4-5 SOL on devnet per deploy), and becomes the program's
# upgrade authority by default. Whoever holds this key can redeploy /
# upgrade the program later.
#
# For devnet/hackathon: a single EOA keypair is fine.
# For mainnet: transfer upgrade authority to a Squads multisig after the
# first deploy via `solana program set-upgrade-authority`. Or deploy with
# --upgrade-authority set explicitly to the multisig.
#
# Restore the same way as PROGRAM_KEYPAIR (same base58 decode script), but
# write the result to a temp file like /tmp/lobsterpay-deployer.json, then
# pass that path to `anchor deploy --provider.wallet <path>` and delete it
# immediately after.
DEPLOYER_KEYPAIR=REPLACE_ME_base58_encoded_64_byte_keypair

# ---------------------------------------------------------------------------
# DEPLOYER_ADDRESS
# ---------------------------------------------------------------------------
# Public address of the deployer wallet. Not secret — this is the address
# you fund from https://faucet.solana.com (devnet) before running
# `anchor deploy`. Kept here so you can re-fund from scripts without
# round-tripping through `solana-keygen pubkey`.
DEPLOYER_ADDRESS=REPLACE_ME_deployer_address_base58_pubkey
