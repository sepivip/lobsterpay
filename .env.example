# Database
DATABASE_URL=postgresql://lobsterpay:lobsterpay@localhost:5432/lobsterpay

# Redis
REDIS_URL=redis://localhost:6379

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
LOBSTERPAY_PROGRAM_ID=

# Backend
API_PORT=3001
API_HOST=0.0.0.0
LOG_LEVEL=info

# Fee payer (base58 secret key — never commit real keys)
FEE_PAYER_SECRET_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_LOBSTERPAY_PROGRAM_ID=

# ── Local test / probe scripts (scripts/*.mjs) ─────────────────────────
# LOBSTERPAY_API: a vault-issued API key (lp_live_xxxxx) used by the local
# probe + e2e scripts in scripts/ to call https://api.lobsterpay.xyz with
# Bearer auth. Get one from the dashboard at https://lobsterpay.xyz/keys.
# NEVER commit a real key - .env is gitignored, this file is the template.
LOBSTERPAY_API=
# Optional: override the API base URL (defaults to https://api.lobsterpay.xyz
# if scripts read it, currently they hard-code prod).
LOBSTERPAY_API_URL=https://api.lobsterpay.xyz

# ── Linear (used by dev-workflow + linear-ops skills) ──────────────────
# LINEAR_API_KEY: personal API key from
#   https://linear.app/settings/account/security/personal-api-keys
# Format: lin_api_xxxxxxxxxxxx. Read+write to your workspace; treat as a
# password.
LINEAR_API_KEY=
# LINEAR_TEAM_PREFIX: short identifier shown in issue numbers (e.g. "LP"
# for issues like LP-42). Visible in Linear under team settings.
LINEAR_TEAM_PREFIX=
# LINEAR_TEAM_ID: UUID of the team that owns LobsterPay issues. Find via
# the Linear MCP (list_teams) or via the Linear UI URL when viewing the
# team settings (the GUID after /team/).
LINEAR_TEAM_ID=
# LINEAR_PROJECT_ID: UUID of the LobsterPay project. Find via list_projects
# or in the URL when the project page is open.
LINEAR_PROJECT_ID=
# LINEAR_STATE_IN_PROGRESS / LINEAR_STATE_DONE: workflow-state UUIDs that
# the dev-workflow skill transitions issues through. Find via list_issue_statuses.
LINEAR_STATE_IN_PROGRESS=
LINEAR_STATE_DONE=
