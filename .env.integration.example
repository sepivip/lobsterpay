# Copy to .env.integration (gitignored) and fill in.
#
# Required.
LOBSTERPAY_API_KEY=lp_live_replace_me
LOBSTERPAY_API_URL=https://api.lobsterpay.xyz

# A devnet pubkey that should receive the small USDC test transfers.
# Use a throwaway / test wallet, NOT a personal Phantom address. Add
# this pubkey to the policy's destinationAllowlist (or set the
# allowlist to empty for allow-all) before running.
TEST_DEST_OWNER=replace_with_devnet_pubkey

# Optional - override the Solana RPC.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional - skip x402 facilitator + SIWX tests that depend on an
# external gateway being reachable.
# SKIP_EXTERNAL=1

# Optional - override the USDC mint (e.g. for a different devnet faucet).
# TEST_USDC_MINT=Gh9ZwEmdLJ8DscKNTkTqPbNwLNNBjuSzaG9Vp2KGtKJr
