{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile && pnpm --filter @lobsterpay/shared build && pnpm --filter @lobsterpay/api build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @lobsterpay/api release && pnpm --filter @lobsterpay/api start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
