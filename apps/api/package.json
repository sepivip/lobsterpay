{
  "name": "@lobsterpay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/skills', 'dist/skills', { recursive: true })\"",
    "start": "node dist/index.js",
    "release": "tsx src/db/migrate.ts",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@lobsterpay/shared": "workspace:*",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "fastify": "^5.8.5",
    "ioredis": "^5.4.2",
    "nanoid": "^5.0.9",
    "postgres": "^3.4.5",
    "tsx": "^4.19.2",
    "tweetnacl": "^1.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
